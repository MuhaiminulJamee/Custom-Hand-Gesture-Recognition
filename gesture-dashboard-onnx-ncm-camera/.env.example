# USB-NCM development-board link. Defaults match NcmCameraTester.cpp.
NCM_HOST_IP=192.168.50.1
NCM_DEVICE_IP=192.168.50.2
NCM_TCP_PORT=5000
NCM_DISCOVERY_PORT=5001
NCM_DISCOVERY_PAYLOAD=JL-CAMERA-DISCOVER
NCM_CONNECT_TIMEOUT_SECONDS=3.0
NCM_RECEIVE_TIMEOUT_SECONDS=0.5
NCM_DISCOVERY_TIMEOUT_SECONDS=1.2
NCM_RECONNECT_DELAY_SECONDS=1.0
NCM_MAX_JPEG_BYTES=204800
NCM_ROTATE_180=false
NCM_AUTO_CONNECT=false
